{
  "name": "finance-data-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.adididitagain/finance-mcp",
  "description": "MCP server giving any LLM agent live stock quotes, crypto prices, SEC filings, insider trades, XBRL financials, FX rates and economic indicators — no API keys required.",
  "license": "MIT",
  "author": "Aditya Bisht",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adididitagain/finance-mcp.git"
  },
  "homepage": "https://github.com/adididitagain/finance-mcp#readme",
  "bugs": {
    "url": "https://github.com/adididitagain/finance-mcp/issues"
  },
  "type": "module",
  "bin": {
    "finance-data-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node scripts/offline-test.mjs && node scripts/sec-test.mjs && node scripts/sources-test.mjs && node scripts/insider-test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "llm",
    "finance",
    "stocks",
    "crypto",
    "sec",
    "edgar",
    "agent",
    "insider-trading",
    "form-4"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^4.5.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
